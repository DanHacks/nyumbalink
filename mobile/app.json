{
  "expo": {
    "name": "NyumbaLink",
    "slug": "nyumbalink",
    "scheme": "nyumbalink",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/favicon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e7490"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/REPLACE_WITH_EAS_PROJECT_ID",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nyumbalink.app",
      "config": {
        "googleMapsApiKey": "AIzaSyAwo2vQn-Z33eKJSFTZ3Pxt-SFz96RkzZc"
      }
    },
    "android": {
      "package": "com.nyumbalink.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAwo2vQn-Z33eKJSFTZ3Pxt-SFz96RkzZc"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#0e7490"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-camera",
      "expo-notifications",
      "expo-asset",
      "expo-font",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://nyumba.hytechsolution.co.ke",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "nyumbalink-mobile"
      }
    }
  }
}
